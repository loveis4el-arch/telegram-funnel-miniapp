# Скопировать в .env и заполнить. .env в git не попадает.
# Комментарии — только отдельной строкой: Docker Compose не отрезает «# …» после значения.

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC

# https-адрес тоннеля на порт 8000 (см. README). Пусто — кнопка миниаппа не ставится
WEBAPP_URL=

# Ваш Telegram id через запятую. Пусто — дашборд видят все, кто открыл его из бота
ADMIN_IDS=

# 1 — дашборд открывается и в обычном браузере (локальная отладка). С тоннелем ставить 0
DASHBOARD_ALLOW_BROWSER=1
